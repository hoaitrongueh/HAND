{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure HAND",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-G",
        "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/c++.exe",
        "-DCMAKE_MAKE_PROGRAM=C:/msys64/ucrt64/bin/ninja.exe",
        "-DHAND_BUILD_MUJOCO=ON",
        "-DMUJOCO_DIR=${env:MUJOCO_DIR}",
        "-DBUILD_TESTING=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build HAND",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "dependsOn": "Configure HAND",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Check HAND dependencies",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/probe_dependencies.py",
        "--output",
        "outputs/vscode-dependency-probe.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test HAND Python",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pytest",
        "-q",
        "--disable-warnings",
        "--basetemp=build/pytest-vscode-task"
      ],
      "dependsOn": "Build HAND",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test HAND C++",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/ctest.exe",
      "args": [
        "--test-dir",
        "${workspaceFolder}/build",
        "--output-on-failure"
      ],
      "dependsOn": "Build HAND",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
